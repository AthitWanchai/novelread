# FastAPI 1.0 backend used while the Next.js frontend is migrated.
FASTAPI_ORIGIN=http://127.0.0.1:8756
NEXT_PUBLIC_LEGACY_ORIGIN=http://127.0.0.1:8756

# Set the public HTTPS origin before deploying; this enables indexing and builds sitemap.xml.
# NEXT_PUBLIC_SITE_URL=https://novelread.example

# Cloud mode: set both values to enable Supabase-backed accounts and library API.
# Keep the service role key server-only; never prefix it with NEXT_PUBLIC_.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable-or-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>
